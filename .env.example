/**
 * Public base URL used in canonical links, sitemap and social metadata.
 * No trailing slash.
 */
VITE_SITE_URL=https://www.hitechdripbox.com

# Optional: store enquiries in Supabase instead of handing them to WhatsApp.
# These values are public frontend values. Never place a service-role key here.
# See README.md for the table + Row Level Security setup.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
